{
  "name": "realstep-head-catalog",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "import-products": "node scripts/import-products.mjs catalog/products.xlsx",
    "check-products": "node scripts/import-products.mjs --check catalog/products.xlsx",
    "compare-catalog": "node scripts/compare-catalog.mjs",
    "update-catalog-baseline": "node scripts/update-catalog-baseline.mjs",
    "test-importer": "node --test \"tests/importer/*.test.mjs\"",
    "test-react": "node --test \"tests/frontend/*.test.mjs\"",
    "test-integrity": "node --test \"tests/integrity/*.test.mjs\" \"tests/frontend/integrityVerifier.test.mjs\"",
    "test:build": "node --test \"tests/build/*.test.mjs\"",
    "verify:build": "node scripts/verify-build.mjs",
    "react:build:signed": "node scripts/build-signed.mjs",
    "generate-signing-keys": "node scripts/generate-signing-keys.mjs",
    "integrity:manifest": "node scripts/generate-integrity-manifest.mjs",
    "integrity:sign": "node scripts/sign-integrity-manifest.mjs",
    "integrity:verify": "node scripts/verify-integrity.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "exceljs": "^4.4.0",
    "vite": "^8.1.5"
  }
}
