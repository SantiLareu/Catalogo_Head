{
  "name": "realstep-head-catalog",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "import-products": "node scripts/import-products.mjs catalog/products.xlsx",
    "check-products": "node scripts/import-products.mjs --check catalog/products.xlsx",
    "compare-catalog": "node scripts/compare-catalog.mjs",
    "update-catalog-baseline": "node scripts/update-catalog-baseline.mjs",
    "test-importer": "node --test \"tests/importer/*.test.mjs\"",
    "test-react": "node --test \"react-app/tests/*.test.mjs\"",
    "react:test": "npm run test-react",
    "react:dev": "npm --prefix react-app run dev",
    "react:build": "npm --prefix react-app run build",
    "react:preview": "npm --prefix react-app run preview"
  },
  "devDependencies": {
    "exceljs": "^4.4.0"
  }
}
